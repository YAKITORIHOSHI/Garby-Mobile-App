+@Composable
+private fun SensorGateChip(label: String, checked: Boolean, onToggle: () -> Unit) {
+    Box(
+        modifier = Modifier
+            .clip(GlassShapes.Pill)
+            .background(if (checked) GarbyColors.Ember.copy(alpha = 0.35f) else GarbyColors.GlassStrokeFaint)
+            .clickable(onClick = onToggle)
+            .padding(horizontal = 14.dp, vertical = 8.dp)
+    ) {
+        Text(
+            text = (if (checked) "✓ " else "✗ ") + label,
+            style = MaterialTheme.typography.labelMedium,
+            fontWeight = if (checked) FontWeight.SemiBold else FontWeight.Normal,
+            color = if (checked) GarbyColors.TextPrimary else GarbyColors.TextMuted
+        )
+    }
+}
+
+@Composable
+private fun DeveloperStatusPanel(status: OperatorStatus?, fresh: Boolean) {
+    GlassPanel {
+        Text("Developer bench status", style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold)
+        Spacer(Modifier.height(8.dp))
+        if (status == null || !fresh) {
+            Text(
+                "Waiting for robot connection. Developer tests require a live link to GARBY.",
+                style = MaterialTheme.typography.bodyMedium, color = GarbyColors.Warning
+            )
+        } else {
+            val statusColor = if (status.developerPending) GarbyColors.Warning else GarbyColors.Ok
+            val statusText = when {
+                status.developerPending -> "Test in progress…"
+                status.developerResult.isNotBlank() -> status.developerResult
+                status.emergencyStopped == true -> "Emergency stop latched (release before testing)"
+                else -> "Ready for bench tests"
+            }
+            InfoLine("Status", statusText, statusColor)
+            val stateText = status.robotState.replace('_', ' ').lowercase()
+                .replaceFirstChar { it.uppercase() }.ifBlank { "Unknown" }
+            InfoLine("Robot state", stateText, GarbyColors.TextPrimary)
+            Spacer(Modifier.height(4.dp))
+            Hint("Developer tests bypass standard route rules for bench checks. The EMERGENCY STOP button halts any test immediately.")
+        }
+    }
+}
